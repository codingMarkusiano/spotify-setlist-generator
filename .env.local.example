# Spotify Web API — Authorization Code (user) flow
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. In Settings → Redirect URIs, add each environment's callback URL, e.g.:
#       http://127.0.0.1:3000/api/auth/callback         (local dev)
#       https://your-app.vercel.app/api/auth/callback   (production)
#    (Spotify requires 127.0.0.1, not "localhost", for HTTP redirect URIs.)
# 3. Copy the Client ID and Client Secret here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must EXACTLY match a Redirect URI registered in the Spotify dashboard.
# - In .env.local (dev), set to your local URL, e.g.
#     SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
# - In Vercel → Project Settings → Environment Variables (Production), set to
#   the deployed URL, e.g.
#     SPOTIFY_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback
# Do NOT paste the local value into Vercel — Spotify will redirect production
# users to localhost.
SPOTIFY_REDIRECT_URI=

# Used to encrypt the session cookie (AES-256-GCM). 32-byte hex.
# Generate with:  openssl rand -hex 32
# Use a different value per environment (don't reuse the dev secret in Vercel).
SESSION_SECRET=
